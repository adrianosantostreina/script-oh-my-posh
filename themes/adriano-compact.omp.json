{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }}",
  "palette": {
    "user": "#82aaff",
    "sep": "#637777",
    "folder": "#21c7a8",
    "branch": "#c792ea",
    "dirty": "#ecc48d",
    "ok": "#22da6e",
    "err": "#ef5350"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:user",
          "template": "{{ .UserName }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:sep",
          "template": "{{ if or (eq .PWD \"~\") (eq .PWD \"/\") (hasSuffix \":\" .PWD) }}\\{{ else }}\\..\\{{ end }}"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:folder",
          "template": "{{ .Path }}",
          "properties": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:branch",
          "template": "<p:sep>\\</> {{ .HEAD }}{{ if or .Working.Changed .Staging.Changed }}<p:dirty> *</>{{ end }}",
          "properties": {
            "fetch_status": true,
            "branch_max_length": 28,
            "truncate_symbol": "…"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:ok",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:err{{ end }}"
          ],
          "template": "❯"
        }
      ]
    }
  ]
}
